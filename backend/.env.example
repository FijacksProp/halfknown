# Copy to backend/.env for local development. Never commit backend/.env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=halfknown-local-only-never-use-in-production-2026
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WS_ALLOWED_ORIGINS=http://localhost:8000
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Halfknown <noreply@localhost>
TRUST_PROXY_SSL_HEADER=False
